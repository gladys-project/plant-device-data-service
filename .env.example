# Placeholders only; supply actual values to the process or Compose.
# Reuse /etc/gladys/gladys.env on the server; keep it outside Git, mode 600.
SPRING_KAFKA_BOOTSTRAPSERVERS=<kafka-host:port>
SPRING_MONGODB_URI=<mongodb-connection-uri-including-database-and-optional-credentials>
# DEVICE_DATA_TOPIC=<device-data-topic>
# PLANT_DEVICE_DATA_GROUP=<dedicated-consumer-group>
# PLANT_DEVICE_DATA_HTTP_PORT=<host-http-port>
# GLADYS_NETWORK=<existing-shared-network>
# Standard Kafka security settings can also be supplied:
# SPRING_KAFKA_SECURITY_PROTOCOL=<security-protocol>
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=<sasl-mechanism>
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=<jaas-configuration>
